# Gopher Auth Configuration
# This should point to your Keycloak realm URL
GOPHER_AUTH_SERVER_URL=http://localhost:8080/realms/gopher-auth
# You need to create a client in Keycloak for your MCP server and use its credentials
GOPHER_CLIENT_ID=example-mcp-server
GOPHER_CLIENT_SECRET=example-server-secret

# Server Configuration
SERVER_PORT=3001
SERVER_URL=http://localhost:3001
SERVER_NAME=Example MCP Server
SERVER_VERSION=1.0.0
TRANSPORT_MODE=http

# Logging
LOG_LEVEL=info

# Environment
NODE_ENV=development
